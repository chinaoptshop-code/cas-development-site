{
  "name": "leadmist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LeadMist / ЛідМіст — B2B-біржа передачі клієнтів (MVP: Telegram-бот + лендинг на Cloudflare Workers)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply leadmist --local",
    "db:migrate:remote": "wrangler d1 migrations apply leadmist --remote",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "wrangler": "^3.99.0"
  }
}
